# ─────────────────────────────────────────────────────────────────────────────
# ConnectHub — Environment Variables
# Copy this file to the root of your project (same folder as docker-compose.yml)
# Then run: docker compose up --build
# ─────────────────────────────────────────────────────────────────────────────

# ─── MySQL ───────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=Bhumi#1705

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASS=guest


# ─── AWS S3 (optional — leave as-is to use local storage fallback) ───────────
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key

# ─── Email (optional — set notification.email.enabled=true to activate) ──────
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here